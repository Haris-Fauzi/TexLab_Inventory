<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Izin Akses Internet untuk Firestore & Cloudinary -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo_texlab"
        android:roundIcon="@drawable/logo_texlab"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TexLabInventory">

        <!-- 1. Halaman Login (Halaman Pertama / Launcher) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Halaman Utama (Dashboard/Katalog) -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- 3. Halaman Detail Aset -->
        <activity
            android:name=".ui.detail.DetailActivity"
            android:exported="false" />

        <!-- 4. Halaman Form Tambah/Edit Laptop -->
        <activity
            android:name=".ui.AddLaptopActivity"
            android:exported="false" />

    </application>

</manifest>