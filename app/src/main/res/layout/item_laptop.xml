<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Image Laptop dari Cloudinary -->
        <ImageView
            android:id="@+id/ivLaptop"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="Foto Laptop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <!-- 1. BARIS ATAS: ID Inventaris (Judul Utama) -->
            <TextView
                android:id="@+id/tvInventoryId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="C001"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

            <!-- 2. BARIS KEDUA: Brand & Model -->
            <TextView
                android:id="@+id/tvBrandModel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="ASUS VIVOBOOK A1404VA"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@android:color/darker_gray" />

            <!-- 3. BARIS KETIGA: Serial Number (Terpisah di Bawahnya) -->
            <TextView
                android:id="@+id/tvSerialNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="SN: T6N0CV035300238"
                android:textSize="12sp"
                android:textColor="@android:color/darker_gray" />

            <!-- 4. BARIS KEEMPAT: Specs Singkat -->
            <TextView
                android:id="@+id/tvSpecs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="INTEL CORE 5 • 8 GB • 512 GB"
                android:textSize="12sp" />

            <!-- 5. BARIS KELIMA: Location & Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📍 LAB CAD"
                    android:textSize="11sp"
                    android:textStyle="italic" />

                <TextView
                    android:id="@+id/tvCondition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NORMAL"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>